<view class="page"><view wx:if="{{error}}" class="card"><text class="error">{{error}}</text><button bindtap="retry">重新登录并加载</button></view><view wx:if="{{message}}" class="card"><text class="heading">{{message.title}}</text><text class="price">¥{{message.price}}</text><text class="muted">{{message.date}} · {{message.platform}}</text><text class="content">{{message.content}}</text><button wx:if="{{message.url}}" type="primary" bindtap="copy">复制购票链接</button></view><button bindtap="home">查看我的全部行程</button></view>
