page{background:#f4f7fb;color:#172740;font-size:28rpx}.page{padding:32rpx}.hero{padding:24rpx 0 40rpx}.title{display:block;font-size:46rpx;font-weight:700}.heading{display:block;font-size:32rpx;font-weight:600;margin-bottom:20rpx}.muted{display:block;color:#748399;font-size:24rpx;line-height:1.8;margin:12rpx 0}.card{background:#fff;border:1rpx solid #e4eaf2;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx}button{font-size:26rpx;margin:16rpx 0}button[type=primary]{background:#2563eb}input,.input{border:1rpx solid #dce4ef;border-radius:12rpx;padding:22rpx;margin:16rpx 0;min-height:40rpx}.row{display:flex;gap:16rpx;align-items:center}.row>button,.row>picker{flex:1}.provider{display:inline-flex;align-items:center;margin:12rpx 20rpx 12rpx 0;font-size:24rpx}checkbox{transform:scale(.8)}.notice{display:block;background:#edf4ff;border-radius:12rpx;padding:20rpx;font-size:24rpx;line-height:1.7;margin:20rpx 0}.error{color:#ae4b3e;font-size:24rpx}.trip{padding:24rpx 0;border-top:1rpx solid #e4eaf2}.fare{padding:16rpx 0;border-top:1rpx solid #f0f3f8}.price{display:block;color:#2563eb;font-size:40rpx;font-weight:700;margin:16rpx 0}.overlay{position:fixed;inset:0;background:#0006;display:flex;align-items:center;padding:24rpx;z-index:20}.picker{width:100%;box-sizing:border-box}.places{height:600rpx}.place{padding:28rpx 8rpx;border-bottom:1rpx solid #edf1f5}.content{white-space:pre-wrap;line-height:1.9;word-break:break-all;font-size:26rpx}
