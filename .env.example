# 默认查价与桌面微信不要求 API Key；下面均为可选配置。
# 显式使用 --notifier pushplus 时才需要下面这一项：
PUSHPLUS_TOKEN=

# 可选，只有选择 provider = "serpapi" 时才需要：
SERPAPI_API_KEY=

# 飞猪 AI 开放平台个人免费 API，可选；不填时使用官方客户端的受限体验模式。
# 获取：https://flyai.open.fliggy.com/console
# 安装官方客户端后，网页下次查询会读取此项；不要把实际 Key 提交到 GitHub。
FLYAI_API_KEY=

# 微信小程序后端（详见 miniprogram/README.md）。AppSecret 仅放在服务器。
# MINIPROGRAM_APP_ID=wx0123456789abcdef
# MINIPROGRAM_APP_SECRET=your_server_only_secret
# MINIPROGRAM_TEMPLATE_ID=your_real_template_id
# 下列字段编号必须换成你实际模板的编号，不能直接假定存在。
# MINIPROGRAM_TEMPLATE_FIELDS={"thing1":"route","amount2":"price","date3":"departure","thing4":"platform"}
# MINIPROGRAM_STATE=trial
